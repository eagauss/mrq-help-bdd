{
  "name": "mrq-help-bdd",
  "version": "1.0.0",
  "private": true,
  "description": "BDD test suite for the MrQ Help Centre using Playwright + playwright-bdd",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "bddgen && playwright test",
    "test:headed": "bddgen && playwright test --headed",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "^25.7.0",
    "playwright-bdd": "^8.2.0",
    "playwright-ctrf-json-reporter": "^0.0.29",
    "typescript": "^6.0.3"
  }
}
